{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["incident_id", "summary", "evidence", "hypothesis", "confidence", "proposed_action", "needs_human"],
  "properties": {
    "incident_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "summary": {"type": "string", "maxLength": 1000},
    "evidence": {"type": "array", "items": {"type": "string"}, "maxItems": 20},
    "hypothesis": {"type": "string", "maxLength": 2000},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "proposed_action": {"type": ["string", "null"], "enum": ["rollback_last_known_good", null]},
    "needs_human": {"type": "boolean"}
  }
}
